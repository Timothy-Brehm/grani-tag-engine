{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://grani.dev/schemas/entity-catalog.json",
  "title": "EntityCatalog",
  "description": "Catalog of engine entity definitions, actions, requirements, and effects",
  "type": "object",
  "required": ["entities"],
  "additionalProperties": false,
  "properties": {
    "entities": {
      "type": "array",
      "items": { "$ref": "#/definitions/EntityDefinition" }
    }
  },
  "definitions": {
    "EntityScope": {
      "type": "string",
      "enum": ["actor", "source", "target"]
    },
    "NoveltyAck": {
      "type": "object",
      "required": ["seenTag"],
      "additionalProperties": false,
      "properties": {
        "seenTag": { "type": "string" },
        "scope": { "type": "string", "enum": ["instance", "primary"] }
      }
    },
    "TagEffect": {
      "type": "object",
      "required": ["type", "name", "strength"],
      "properties": {
        "type": { "type": "string" },
        "name": { "type": "string" },
        "strength": { "type": "number" },
        "stat": { "type": "string" },
        "pool": { "type": "string" }
      },
      "additionalProperties": true
    },
    "Tag": {
      "type": "object",
      "required": ["name", "effects"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "label": { "type": "string" },
        "effects": {
          "type": "array",
          "items": { "$ref": "#/definitions/TagEffect" }
        }
      }
    },
    "Requirement": {
      "type": "object",
      "required": ["type"],
      "oneOf": [
        {
          "properties": { "type": { "const": "free" } },
          "required": ["type"],
          "additionalProperties": false
        },
        {
          "properties": { "type": { "const": "forbidden" } },
          "required": ["type"],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": { "const": "tag" },
            "tagName": { "type": "string" },
            "exists": { "type": "boolean" },
            "scope": { "$ref": "#/definitions/EntityScope" }
          },
          "required": ["type", "tagName", "exists"],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": { "const": "stat" },
            "stat": { "type": "string" },
            "amount": { "type": "number" },
            "scope": { "$ref": "#/definitions/EntityScope" }
          },
          "required": ["type", "stat", "amount"],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": { "const": "pool-max" },
            "pool": { "type": "string" },
            "amount": { "type": "number" },
            "scope": { "$ref": "#/definitions/EntityScope" }
          },
          "required": ["type", "pool", "amount"],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": { "const": "entity-count" },
            "definitionId": { "type": "string" },
            "min": { "type": "number" },
            "max": { "type": "number" }
          },
          "required": ["type", "definitionId"],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": { "const": "metric" },
            "metric": { "const": "engine-tick" },
            "amount": { "type": "number" }
          },
          "required": ["type", "metric", "amount"],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": { "const": "metric" },
            "metric": {
              "type": "string",
              "enum": ["action-manual", "action-automatic", "action-total"]
            },
            "actionId": { "type": "string" },
            "amount": { "type": "number" },
            "scope": { "$ref": "#/definitions/EntityScope" }
          },
          "required": ["type", "metric", "actionId", "amount"],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": { "const": "metric" },
            "metric": {
              "type": "string",
              "enum": [
                "pool-current",
                "pool-high-water",
                "pool-low-water",
                "pool-max-high-water",
                "pool-lifetime-used"
              ]
            },
            "pool": { "type": "string" },
            "amount": { "type": "number" },
            "scope": { "$ref": "#/definitions/EntityScope" }
          },
          "required": ["type", "metric", "pool", "amount"],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": { "const": "metric" },
            "metric": {
              "type": "string",
              "enum": ["stat-high-water", "stat-low-water"]
            },
            "stat": { "type": "string" },
            "amount": { "type": "number" },
            "scope": { "$ref": "#/definitions/EntityScope" }
          },
          "required": ["type", "metric", "stat", "amount"],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": { "const": "metric" },
            "metric": { "const": "tag-held-for" },
            "tagName": { "type": "string" },
            "amount": { "type": "number" },
            "scope": { "$ref": "#/definitions/EntityScope" }
          },
          "required": ["type", "metric", "tagName", "amount"],
          "additionalProperties": false
        }
      ]
    },
    "EffectApplyDuring": {
      "oneOf": [
        {
          "type": "object",
          "required": ["mode", "ticks"],
          "additionalProperties": false,
          "properties": {
            "mode": { "enum": ["first", "last"] },
            "ticks": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        {
          "type": "object",
          "required": ["mode", "percent"],
          "additionalProperties": false,
          "properties": {
            "mode": { "enum": ["first", "last"] },
            "percent": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 }
          }
        },
        {
          "type": "object",
          "required": ["mode", "fromTicks", "toTicks"],
          "additionalProperties": false,
          "properties": {
            "mode": { "const": "middle" },
            "fromTicks": { "type": "number", "minimum": 0 },
            "toTicks": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        {
          "type": "object",
          "required": ["mode", "fromPercent", "toPercent"],
          "additionalProperties": false,
          "properties": {
            "mode": { "const": "middle" },
            "fromPercent": { "type": "number", "minimum": 0, "maximum": 100 },
            "toPercent": { "type": "number", "minimum": 0, "maximum": 100 }
          }
        }
      ]
    },
    "ActiveEffect": {
      "type": "object",
      "required": ["type", "name", "strength"],
      "oneOf": [
        {
          "properties": {
            "type": { "const": "adjust-pool" },
            "name": { "type": "string" },
            "strength": { "type": "number" },
            "pool": { "type": "string" },
            "poolTypes": {
              "type": "array",
              "items": { "type": "string" }
            },
            "createPool": { "type": "boolean" },
            "scope": { "$ref": "#/definitions/EntityScope" },
            "applyDuring": { "$ref": "#/definitions/EffectApplyDuring" }
          },
          "required": ["type", "name", "strength"],
          "anyOf": [
            { "required": ["pool"] },
            { "required": ["poolTypes"] }
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": { "const": "grant-tag" },
            "name": { "type": "string" },
            "strength": { "type": "number" },
            "scope": { "$ref": "#/definitions/EntityScope" },
            "applyDuring": { "$ref": "#/definitions/EffectApplyDuring" }
          },
          "required": ["type", "name", "strength"],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": { "const": "lock-tag" },
            "name": { "type": "string" },
            "strength": { "type": "number" },
            "scope": { "$ref": "#/definitions/EntityScope" },
            "applyDuring": { "$ref": "#/definitions/EffectApplyDuring" }
          },
          "required": ["type", "name", "strength"],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": { "const": "spawn-entity" },
            "name": { "type": "string" },
            "strength": { "type": "number" },
            "definitionId": { "type": "string" },
            "entityId": { "type": "string" },
            "applyDuring": { "$ref": "#/definitions/EffectApplyDuring" }
          },
          "required": ["type", "name", "strength", "definitionId"],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": { "const": "remove-entity" },
            "name": { "type": "string" },
            "strength": { "type": "number" },
            "scope": { "$ref": "#/definitions/EntityScope" },
            "applyDuring": { "$ref": "#/definitions/EffectApplyDuring" }
          },
          "required": ["type", "name", "strength"],
          "additionalProperties": false
        }
      ]
    },
    "ActionDefinition": {
      "type": "object",
      "required": ["name", "requirements", "requiredImmediateEffects", "requiredFinishedEffects", "optionalFinishedEffects"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "label": { "type": "string" },
        "sourceId": { "type": "string" },
        "durationTicks": { "type": "number" },
        "repeatWhileAvailable": { "type": "boolean" },
        "types": {
          "type": "array",
          "items": { "type": "string" }
        },
        "novelty": { "$ref": "#/definitions/NoveltyAck" },
        "requirements": {
          "type": "array",
          "items": { "$ref": "#/definitions/Requirement" }
        },
        "requiredImmediateEffects": {
          "type": "array",
          "items": { "$ref": "#/definitions/ActiveEffect" }
        },
        "optionalImmediateEffects": {
          "type": "array",
          "items": { "$ref": "#/definitions/ActiveEffect" }
        },
        "requiredOverTimeEffects": {
          "type": "array",
          "items": { "$ref": "#/definitions/ActiveEffect" }
        },
        "optionalOverTimeEffects": {
          "type": "array",
          "items": { "$ref": "#/definitions/ActiveEffect" }
        },
        "requiredFinishedEffects": {
          "type": "array",
          "items": { "$ref": "#/definitions/ActiveEffect" }
        },
        "optionalFinishedEffects": {
          "type": "array",
          "items": { "$ref": "#/definitions/ActiveEffect" }
        }
      }
    },
    "EntityDefinition": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "displayName": { "type": "string" },
        "description": { "type": "string" },
        "initialTags": {
          "type": "array",
          "items": { "$ref": "#/definitions/Tag" }
        },
        "initialPools": {
          "type": "object",
          "additionalProperties": { "type": "number" }
        },
        "actions": {
          "type": "array",
          "items": { "$ref": "#/definitions/ActionDefinition" }
        },
        "maxActive": { "type": "integer", "minimum": 0 },
        "maxCreated": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
